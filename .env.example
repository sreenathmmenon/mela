VITE_SPACETIMEDB_DB_NAME=mela-cah23
VITE_SPACETIMEDB_HOST=ws://localhost:3000
# Production build values:
# VITE_SPACETIMEDB_HOST=https://maincloud.spacetimedb.com
# VITE_SPACETIMEDB_DB_NAME=<maincloud-database-name>
# VITE_PUBLIC_APP_URL=https://<public-frontend-origin>
# Optional: GoatCounter visitor counting. Set to your site code (the
# <code> in https://<code>.goatcounter.com). Unset means no analytics.
# VITE_GOATCOUNTER_CODE=<goatcounter-site-code>
# Server-only email delivery (Railway runtime; NEVER prefix these with VITE_):
# RESEND_EMAIL_API_KEY=<Resend sending key>
# MELA_EMAIL_FROM=Mela <recap@your-verified-domain.example>
# Local transport uses PORT=8082; Vite proxies /api/recap to that port.
