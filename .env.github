# Values for `pnpm run build:pages` (vite --mode github), which serves under
# /mela/ on GitHub Pages. Vite loads .env.<mode>, so .env.production does NOT
# apply to this build — these have to be repeated here.
#
# The deploy workflow passes the same values as real env vars, so CI does not
# depend on this file; it exists so a local `build:pages` matches production.
VITE_SPACETIMEDB_HOST=https://maincloud.spacetimedb.com
VITE_SPACETIMEDB_DB_NAME=mela-cah23
VITE_PUBLIC_APP_URL=https://sreenathmenon.com/mela
VITE_GOATCOUNTER_CODE=mela
