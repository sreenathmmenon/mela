{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  // displayNameRules is pure logic with no server imports, and both the
  // reducer and the client validate against it — the server as the real gate,
  // the client only to show the player WHY a name was refused. Including it
  // here keeps one source of truth instead of two drifting copies.
  "include": [
    "src",
    "vite.config.ts",
    "spacetimedb/src/displayNameRules.ts"
  ]
}
