# Values baked into every production build (`pnpm run build` and
# `build:pages`). Committed deliberately: none of these are secrets, they are
# public endpoints and a public analytics site code.
#
# VITE_PUBLIC_APP_URL is deliberately absent. The two deployments serve on
# different origins — GitHub Pages under /mela/ and Railway at its own domain —
# and the app falls back to location.origin, which is correct on both. Pinning
# one origin here would make the other's QR codes point at the wrong site.
VITE_SPACETIMEDB_HOST=https://maincloud.spacetimedb.com
VITE_SPACETIMEDB_DB_NAME=mela-cah23
VITE_GOATCOUNTER_CODE=mela

# Gates the operator dashboard at ?operator=<key>. NOT a secret: Vite inlines
# every VITE_ variable into the public JS bundle, so anyone who reads the
# bundle can find this. It stops someone guessing the URL at an event, which
# is the actual risk; the dashboard shows aggregate counts and no identities.
VITE_OPERATOR_KEY=c2a37472828084964c76d019
